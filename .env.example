# Copier ce fichier en .env.local puis remplir avec les valeurs de ton projet Supabase
# (Dashboard Supabase → Project Settings → API)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# resend.com → API Keys. RESEND_FROM_EMAIL doit être une adresse sur un
# domaine vérifié dans Resend (sinon les emails ne partent qu'à ta propre
# adresse de test) — ex. "Le Foyer <suivi@tondomaine.com>"
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# console.twilio.com → Account SID + Auth Token (page d'accueil du compte).
# TWILIO_FROM_NUMBER : un numéro Twilio capable d'envoyer des SMS
# (Phone Numbers → Buy a number). Vérifie aussi Messaging → Geo Permissions
# pour activer le Cameroun, sinon les SMS vers Orange/MTN/Camtel échouent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
